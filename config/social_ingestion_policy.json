  "user_nav_exposure": "contextual_only_for_admitted_public_pages",
  "throttle": {
    "delayMs": 500,
    "maxRetries": 1,
    "timeoutMs": 5000,
    "maxRuntimeMs": 30000
  },
  "routine_approval_required": false
}
