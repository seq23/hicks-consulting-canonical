{
  "publishMode": "full_safe_autonomy",
  "humanizedByLlmRequired": true,
  "prewriteSelfRepairRequired": true,
  "defaultFlexMargin": 0.2,
  "contentTypes": {
    "insight": {
      "targetWords": 900,
      "minimumWords": 720,
      "approvalRequired": false
    },
    "article": {
      "targetWords": 1200,
      "minimumWords": 960,
      "approvalRequired": false
    },
    "guide": {
      "targetWords": 1400,
      "minimumWords": 1120,
      "approvalRequired": false
    },
    "whitepaper": {
      "targetWords": 2500,
      "minimumWords": 2000,
      "approvalRequired": false
    },
    "faq": {
      "targetWords": 700,
      "minimumWords": 560,
      "approvalRequired": false
    },
    "fanout": {
      "targetWords": 900,
      "minimumWords": 720,
      "approvalRequired": false
    }
  },
  "humanizationChecklist": [
    "Use plain human language rather than generic therapy marketing copy.",
    "Vary sentence rhythm and paragraph length.",
    "Include concrete examples without inventing client stories.",
    "Avoid exaggerated claims, guarantees, diagnosis, or pressure language.",
    "Keep Monika Hicks / Hicks Consulting entity references consistent.",
    "End with an approved conversion path only after value is delivered."
  ],
  "prewriteGate": {
    "requiredFields": [
      "id",
      "clusterId",
      "contentType",
      "title",
      "targetWords",
      "minimumWords",
      "autonomyStatus",
      "llmPrompt",
      "humanizationChecklist",
      "conversionPath"
    ],
    "allowedAutonomyStatuses": [
      "DISCOVERED",
      "SCORED",
      "ADMITTED",
      "DRAFTING",
      "DRAFTED",
      "VALIDATING",
      "REPAIRING",
      "VALIDATED_SAFE",
      "SCHEDULED",
      "PUBLISHED",
      "DISTRIBUTED",
      "MEASURED",
      "SKIPPED_DUPLICATE",
      "SKIPPED_UNSUPPORTED_CLAIM",
      "SKIPPED_PROTECTED_OWNER",
      "SKIPPED_PROHIBITED_ACTION",
      "FAILED_RETRYABLE",
      "SYSTEM_BLOCKED"
    ]
  },
  "postPublicationNotificationRequired": true,
  "routineApprovalRequired": false,
  "protectedFacts": [
    "credentials",
    "physical office location",
    "fees",
    "insurance participation",
    "availability",
    "testimonials",
    "personal stories",
    "clinical outcomes",
    "unapproved treatment methods"
  ]
}
